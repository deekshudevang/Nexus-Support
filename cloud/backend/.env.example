# Environment configuration: development | production
ENVIRONMENT=development

# Database connection (PostgreSQL required in production; SQLite fallback allowed only in development)
DATABASE_PATH=meshlink_sync.db
DATABASE_URL=sqlite:///./meshlink_sync.db

# Allowed CORS origins (comma-separated, HTTPS without localhost or '*' in production)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Gateway API keys for mesh ingestion (comma-separated for key rotation)
GATEWAY_API_KEYS=meshlink_gw_dev_secret

# Operator bearer tokens for dashboard access (comma-separated)
OPERATOR_TOKENS=meshlink_op_dev_secret

# Required >= 32 character high-entropy signing key in production
JWT_SECRET=replace_with_at_least_32_char_random_hex_secret_in_production

# Revoked credentials list (revoked keys or tokens)
REVOKED_CREDENTIALS=

# Rate limiting
RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW_SEC=60
