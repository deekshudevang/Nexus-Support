# Environment configuration: development | production
ENVIRONMENT=development

# Database path (SQLite file location)
DATABASE_PATH=meshlink_sync.db

# Allowed CORS origins (comma-separated, without trailing slashes)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Gateway API keys for mesh ingestion (comma-separated for rotation)
GATEWAY_API_KEYS=meshlink_gw_dev_secret

# Operator bearer tokens for dashboard access (comma-separated)
OPERATOR_TOKENS=meshlink_op_dev_secret

# Revoked credentials list (revoked keys or tokens)
REVOKED_CREDENTIALS=

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60
