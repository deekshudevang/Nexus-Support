# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicit text files
*.kt text eol=lf
*.java text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.proto text eol=lf
*.md text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf

# Windows batch files must retain CRLF
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary files
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.map binary
*.bin binary
