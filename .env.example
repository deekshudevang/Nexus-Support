# Root Compose Environment Configuration (Copy to .env and replace secrets for production)

ENVIRONMENT=development
POSTGRES_DB=rescuemesh
POSTGRES_USER=rescuemesh
POSTGRES_PASSWORD=rescuemesh_dev_secret
DATABASE_URL=postgresql://rescuemesh:rescuemesh_dev_secret@db:5432/rescuemesh

# Production requires HTTPS origins without localhost or wildcard '*'
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# High-entropy secrets required in production (alembic + FastAPI refuse dev defaults)
GATEWAY_API_KEYS=meshlink_gw_dev_secret
OPERATOR_TOKENS=meshlink_op_dev_secret
JWT_SECRET=replace_with_at_least_32_char_random_hex_secret_in_production
REVOKED_CREDENTIALS=

# Frontend build-time endpoints (no secrets here!)
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

RATE_LIMIT_REQUESTS=10000
RATE_LIMIT_WINDOW_SEC=60
