# Production Environment Configuration Template (NEVER commit populated .env.production!)
# Copy to .env.production on the production host and fill all secrets cleanly.

ENVIRONMENT=production

# Database (PostgreSQL + PostGIS mandatory in production; SQLite is rejected on startup)
POSTGRES_DB=rescuemesh
POSTGRES_USER=rescuemesh_app
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD
DATABASE_URL=postgresql+psycopg2://rescuemesh_app:REPLACE_WITH_STRONG_RANDOM_DB_PASSWORD@db:5432/rescuemesh

# Public TLS domain served by Caddy (or reverse proxy hostname)
CADDY_SITE=command.example.org

# Explicit HTTPS CORS allowlist (comma-separated, NO http://, NO localhost, NO '*')
CORS_ORIGINS=https://command.example.org

# High-entropy production credentials (>= 32 random chars recommended; dev defaults rejected)
JWT_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_SECRET
GATEWAY_API_KEYS=REPLACE_WITH_HIGH_ENTROPY_GATEWAY_KEY
OPERATOR_TOKENS=REPLACE_WITH_HIGH_ENTROPY_OPERATOR_TOKEN
REVOKED_CREDENTIALS=

# Frontend build-time endpoints (no secrets here)
VITE_API_URL=https://command.example.org
VITE_WS_URL=wss://command.example.org

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SEC=60
