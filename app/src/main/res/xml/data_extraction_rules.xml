<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="meshlink.db" />
        <exclude domain="sharedpref" path="meshlink_db_secure_prefs.xml" />
        <exclude domain="sharedpref" path="meshlink_keyset_prefs.xml" />
        <exclude domain="sharedpref" path="meshlink_identity_secure_v2.xml" />
        <exclude domain="sharedpref" path="meshlink_identity_secure_v2_keyset.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="meshlink.db" />
        <exclude domain="sharedpref" path="meshlink_db_secure_prefs.xml" />
        <exclude domain="sharedpref" path="meshlink_keyset_prefs.xml" />
        <exclude domain="sharedpref" path="meshlink_identity_secure_v2.xml" />
        <exclude domain="sharedpref" path="meshlink_identity_secure_v2_keyset.xml" />
    </device-transfer>
</data-extraction-rules>