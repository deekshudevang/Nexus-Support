<?xml version="1.0" encoding="utf-8"?>
<!--
    Release Network Security Configuration for Nexus-Support.
    Strict HTTPS-only policy: cleartext HTTP traffic is blocked in all non-debug builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
